{
 "_nota": "Regole dichiarative del giudizio su una carta. Ogni regola: id, roles (oppure roles_except), when (condizione), effect (score = variazione dello score con tetto, tag), pro_text/con_text, source (manual|learned), status (active|proposed|rejected), evidence. Contano solo le regole 'active'; le 'proposed' aspettano l'approvazione. Segnaposto nei testi: {items} {value} {avg} {role_it} {name} {body_type} {stars} {role}.",
 "version": 1,
 "settings": {
  "max_rule_delta": 3.0,
  "max_total_delta": 4.0,
  "learn": {
   "min_mentions": 5,
   "min_creators": 2,
   "min_consensus": 0.6,
   "per_mention": 0.2,
   "max_new_delta": 1.5,
   "max_step": 0.5,
   "positive_gte": 85,
   "negative_lt": 70,
   "templates": {
    "height":      {"pos": {"type": "height_cm", "gte": 185}, "neg": {"type": "height_cm", "lte": 170}},
    "body_type":   {"pos": {"type": "body_type", "in": ["Lean", "Unique", "Custom"]}, "neg": {"type": "body_type", "in": ["Stocky"]}},
    "animations":  {"pos": {"type": "body_type", "in": ["Lean", "Unique", "Custom"]}, "neg": {"type": "body_type", "in": ["Stocky"]}},
    "weak_foot":   {"pos": {"type": "weak_foot", "gte": 5}, "neg": {"type": "weak_foot", "lte": 2}},
    "skill_moves": {"pos": {"type": "skill_moves", "gte": 5}, "neg": {"type": "skill_moves", "lte": 2}},
    "playstyle":   {"pos": {"type": "playstyle_group", "group": "in_role"}, "neg": {"type": "playstyle_group", "group": "off_role"}}
   }
  },
  "calibration": {
   "min_cards_rule": 5,
   "min_diff": 5.0,
   "delta_step": 0.25,
   "threshold_step": 2
  }
 },
 "rules": [
  {"id": "forza-stat-alte", "roles_except": [], "when": {"type": "role_top_stats", "top_n": 6, "gte": 88, "max_items": 4},
   "effect": {"score": 0, "tag": "stat_alte"}, "pro_text": "Punti di forza per il ruolo: {items}.", "con_text": null,
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "debolezza-stat-basse", "roles_except": [], "when": {"type": "role_weak_stats", "min_weight": 2, "lt": 70, "max_items": 3},
   "effect": {"score": 0, "tag": "stat_basse"}, "pro_text": null, "con_text": "Punti deboli che contano per il ruolo: {items}.",
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "scatto-vertice", "roles": ["ST", "CF", "W", "CAM", "FB", "WB", "CB"], "criterion": "pace",
   "when": {"type": "avg", "stats": ["acceleration", "sprint_speed"], "gte": 88},
   "effect": {"score": 0, "tag": "pace"}, "pro_text": "Scatto e velocità da vertice (media {value:.0f}): nel meta attuale fanno spesso la differenza.", "con_text": null,
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "scatto-basso-offensivi", "roles": ["ST", "W", "FB", "WB", "CF"], "criterion": "pace",
   "when": {"type": "avg", "stats": ["acceleration", "sprint_speed"], "lt": 72},
   "effect": {"score": 0, "tag": "pace"}, "pro_text": null, "con_text": "Scatto e velocità bassi (media {value:.0f}) per un {role_it}: soffrirà contro avversari rapidi.",
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "difensore-lento", "roles": ["CB"], "criterion": "pace",
   "when": {"type": "avg", "stats": ["acceleration", "sprint_speed"], "lt": 66},
   "effect": {"score": 0, "tag": "pace"}, "pro_text": null, "con_text": "Difensore lento (velocità media {value:.0f}): rischioso contro attaccanti veloci.",
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "playstyle-utili", "roles_except": [], "criterion": "playstyle", "when": {"type": "playstyle_group", "group": "in_role"},
   "effect": {"score": 0, "tag": "playstyle"}, "pro_text": "PlayStyle+ utili al ruolo: {items}.", "con_text": null,
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "playstyle-fuori-ruolo", "roles_except": [], "criterion": "playstyle", "when": {"type": "playstyle_group", "group": "off_role"},
   "effect": {"score": 0, "tag": "playstyle"}, "pro_text": null, "con_text": "PlayStyle+ poco utili a questo ruolo (contano meno): {items}.",
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "playstyle-sconosciuti", "roles_except": [], "when": {"type": "playstyle_group", "group": "unknown"},
   "effect": {"score": 0, "tag": "playstyle"}, "pro_text": null, "con_text": "PlayStyle+ non in tabella (bonus minimo): {items}.",
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "body-type-reattivo", "roles_except": ["GK"], "criterion": "body_type", "when": {"type": "body_type", "in": ["Lean", "Unique", "Custom"]},
   "effect": {"score": 0, "tag": "body_type"}, "pro_text": "Body type {body_type}: animazioni più reattive.", "con_text": null,
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "skill-5-stelle", "roles": ["ST", "CF", "W", "CAM"], "criterion": "skill_moves", "when": {"type": "skill_moves", "gte": 5},
   "effect": {"score": 0, "tag": "skill_moves"}, "pro_text": "5 stelle di skill: dribbling e finte complete.", "con_text": null,
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "skill-poche-stelle", "roles": ["ST", "CF", "W", "CAM"], "criterion": "skill_moves", "when": {"type": "skill_moves", "lte": 2},
   "effect": {"score": 0, "tag": "skill_moves"}, "pro_text": null, "con_text": "Solo {stars}★ di skill moves: poche finte per un ruolo offensivo.",
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "piede-debole-5", "roles": ["ST", "CF", "W", "CAM"], "criterion": "weak_foot", "when": {"type": "weak_foot", "gte": 5},
   "effect": {"score": 0, "tag": "weak_foot"}, "pro_text": "5★ di piede debole: letale con entrambi i piedi.", "con_text": null,
   "source": "manual", "status": "active", "evidence": {}},
  {"id": "piede-debole-basso", "roles": ["ST", "CF", "W", "CAM"], "criterion": "weak_foot", "when": {"type": "weak_foot", "lte": 2},
   "effect": {"score": 0, "tag": "weak_foot"}, "pro_text": null, "con_text": "Solo {stars}★ di piede debole: prevedibile nelle conclusioni.",
   "source": "manual", "status": "active", "evidence": {}}
 ],
 "advice": [
  {"levels": ["top", "meta"], "verdict": "MUST_DO", "text": "Da prendere: è forte e costa meno di quanto vale."},
  {"levels": ["top", "meta"], "verdict": "AVOID", "text": "Forte ma cara per quello che offre: valuta alternative più economiche prima di spendere."},
  {"levels": ["top", "meta"], "verdict": "*", "no_market": true, "text": "Buona carta: prendila se ti serve il ruolo (confronta il prezzo con altre carte quando ne avrai inserite di più)."},
  {"levels": ["top", "meta"], "verdict": "*", "text": "Buona carta: prendila se ti serve il ruolo."},
  {"levels": ["playable"], "verdict": "MUST_DO", "text": "Non è meta, ma per il prezzo è un buon acquisto di ripiego."},
  {"levels": ["playable"], "verdict": "AVOID", "text": "Da evitare: non è meta e costa troppo."},
  {"levels": ["playable"], "verdict": "*", "text": "Opzionale: giocabile ma non fa la differenza; prendila solo se la trovi a poco."},
  {"levels": ["below"], "verdict": "MUST_DO", "text": "Da evitare per giocare ai livelli alti: regge solo come riempitivo molto economico."},
  {"levels": ["below"], "verdict": "*", "text": "Da evitare per giocare ai livelli alti: non è competitiva e il prezzo non la giustifica."}
 ]
}
